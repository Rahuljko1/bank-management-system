NODE_ENV=development
PORT=4000
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:4000,http://localhost:4000
# In production use HTTPS origins only; set TRUST_PROXY to the proxy hop count if TLS terminates upstream.
TRUST_PROXY=
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
SESSION_COOKIE_NAME=smartbank.sid
SESSION_TTL_MINUTES=60
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_bank
DB_USER=root
DB_PASSWORD=
FICTIONAL_STARTING_BALANCE=10000.00
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Optional. After you register this email, npm run migrate promotes it to admin.
# ADMIN_EMAIL=admin@example.com
